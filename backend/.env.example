# Copy to .env and fill in. Everything here is optional except DATABASE_URL -
# the app boots without AI or voice credentials and degrades those features.

DATABASE_URL=postgresql://admin:password123@localhost/literacy_app
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- AI reports (Anthropic) ---
# Without this, reports fall back to a deterministic rule-based generator.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium

# --- Multilingual voice (Sarvam AI) ---
# Without this, /voice/capabilities reports server_stt=false and the frontend
# falls back to the browser's Web Speech API.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TRANSLATE_MODEL=mayura:v1

# --- Assessment tuning ---
PLACEMENT_MIN_QUESTIONS=12
PLACEMENT_MAX_QUESTIONS=20
PLACEMENT_TARGET_SE=0.45
PRACTICE_TEST_LENGTH=8
